{
  "name": "bijli-bill-explainer",
  "private": true,
  "version": "1.0.0",
  "description": "An Urdu-first web app that reads a photo of a Pakistani electricity bill and explains, line by line in plain Urdu, where the money went and why the bill went up.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "e2e": "playwright test",
    "capture": "node scripts/capture.mjs",
    "fixture": "node scripts/make-fixture.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
