# Copy to .env.local for local development, and set the same names in the
# Vercel project (Settings → Environment Variables) for the live site.

# Required: an API key for an OpenAI-compatible chat completions endpoint.
# A free OpenRouter key works: https://openrouter.ai/keys
AI_API_KEY=your-key-here

# Optional: defaults to https://openrouter.ai/api/v1
# Google's Gemini API also works: https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=

# Optional: comma-separated vision models, tried in order when one is busy.
# Defaults to qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free
AI_MODEL=
